# LeadForge AI Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to Git.

# Core: Database (Prisma)
# -----------------------------------------------------------------------------
# Connection string for PostgreSQL.
# Example: postgresql://user:password@localhost:5432/leadforge
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Authentication (Auth.js)
# -----------------------------------------------------------------------------
# Generate a secret using: npx auth secret
AUTH_SECRET="your-auth-secret-here"

# Google OAuth (for Login & Gmail Integrations)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# AI: Providers
# -----------------------------------------------------------------------------
# Required for agentic workflows (Research, Audit, Outreach)
OPENAI_API_KEY="sk-..."

# Billing: Stripe (Pro Features)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_AGENCY_PRICE_ID="price_..."

# Application URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags & Dev Mode
# -----------------------------------------------------------------------------
# Set to 'true' to enable mock data flows when AI/DB is disconnected
ENABLE_DEMO_MODE="true"
