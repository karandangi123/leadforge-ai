# ──────────────────────────────────────────────────────────────────────────────
# LeadForge AI — Environment Configuration Example
# ──────────────────────────────────────────────────────────────────────────────
# This file defines the environment contract for LeadForge AI.
# Duplicate this file to '.env' and fill in your private credentials.
# NEVER commit your actual '.env' file to version control.

# ─── Platform Core ────────────────────────────────────────────────────────────
# The base URL of your deployment (used for OAuth redirects and emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used for NextAuth encryption and session signing
# Generate one with: 'openssl rand -base64 32'
AUTH_SECRET="your-auth-secret-here"

# Database connection string (PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@localhost:5432/leadforge"

# ─── Strategic Boundaries (Open-Core vs SaaS) ──────────────────────────────────
# Set to 'true' to enable Stripe billing and premium entitlement gating
LEADFORGE_PRO_MODE="false"

# The URL of your private prompt/logic API (if using the remote prompt registry)
LEADFORGE_PRIVATE_PROMPT_URL=""

# Internal key for authenticating dashboard requests to private backend services
LEADFORGE_INTERNAL_KEY="generate-a-secure-key"

# ─── AI & LLM Orchestration ──────────────────────────────────────────────────
# Primary provider for Agentic workflows (OpenAI recommended)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Optional: Anthropic fallback for complex research tasks
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Integrations: Google Workspace ───────────────────────────────────────────
# Required for Gmail sequencing and Calendar sync
GOOGLE_CLIENT_ID="your-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ─── Integrations: Enrichment & Data ──────────────────────────────────────────
# Each key unlocks higher-fidelity data in the enrichment waterfall
CLEARBIT_API_KEY="your-clearbit-key"
APOLLO_API_KEY="your-apollo-key"
BUILTWITH_API_KEY="your-builtwith-key"
HUNTER_API_KEY="your-hunter-key"

# ─── Integrations: Multi-Channel ─────────────────────────────────────────────
# Twilio for SMS and Dialer capabilities
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="+1..."

# LinkedIn Sales Navigator API (requires partner approval)
LINKEDIN_CLIENT_ID="your-linkedin-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-secret"
LINKEDIN_SALES_NAVIGATOR_TOKEN="your-sales-nav-token"

# ─── Commercial: Stripe ──────────────────────────────────────────────────────
# Required if LEADFORGE_PRO_MODE="true"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_AGENCY_PRICE_ID="price_..."
