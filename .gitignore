# LeadForge AI Global Git Ignore
# -----------------------------------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
apps/dashboard/playwright-report
apps/dashboard/test-results
test-results/
*.lcov

# Next.js / Build Artifacts
/.next/
/out/
apps/*/.next/
apps/*/out/
/build
dist/
*.tsbuildinfo
next-env.d.ts

# Turborepo
.turbo

# OS / Metafiles
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets
# -----------------------------------------------------------------------------
# NEVER commit .env files to the repository.
# Use .env.example for variable documentation.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
! .env.example

# Vercel
.vercel

# Prisma / Generated Code
# -----------------------------------------------------------------------------
/src/generated/prisma
apps/dashboard/src/generated/prisma
packages/db/src/generated

# Temp / Local Data
output/
tmp/
*.db
*.db-journal
*.sqlite
.env*.local
.env.vercel-production
